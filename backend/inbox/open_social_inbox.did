// One account's data, as moved between canisters.
type AccountExport = record {
  mail : vec record { text; MailItem };
  last_resort : vec record { text; blob };
  single_use : vec record { text; blob };
  devices : vec Device;
};
// Stored entry ids, and the indexes of entries skipped because their device's mailbox is full.
type BatchResult = record { ids : vec nat64; skipped : vec nat32 };
type ClaimedKeyPackage = record { last_resort : blob; single_use : opt blob };
type CommitArgs = record {
  // Accounts to give access (admins only).
  add : vec principal;
  // Accounts to take access from (admins remove members; the owner anyone).
  remove : vec principal;
  welcome : opt nat64;
  device : text;
  epoch : nat64;
  group : text;
  commit : blob;
};
type DepositItem = record {
  to : principal;
  device_id : text;
  entry : blob;
  // Direct-link offer: capped per sender and dropped after 10 minutes.
  ephemeral : bool;
};
type Device = record {
  added_at_ns : nat64;
  device_id : text;
  label : text;
  encryption_key : blob;
  signing_key : blob;
};
type DeviceInput = record {
  device_id : text;
  label : text;
  encryption_key : blob;
  signing_key : blob;
};
type Entry = record {
  seq : nat64;
  at_ns : nat64;
  // A commit that adds members: the blob holding its Welcome.
  welcome : opt nat64;
  data : blob;
  from : principal;
  kind : EntryKind;
  // The sending device (as the sender says; the MLS signature is what counts).
  device : text;
  // The epoch the entry was made in.
  epoch : nat64;
};
type EntryKind = variant {
  // An MLS application message.
  Message;
  // An MLS commit (moves the group to the next epoch).
  Commit;
};
type Head = record {
  // The asker's role (they are a member, or the group isn't listed).
  role : Role;
  epoch : nat64;
  group : text;
  // Seq of the latest entry (0: none yet).
  last_seq : nat64;
};
type InitArgs = record {
  shard_number : nat32;
  orchestrator : principal;
  identity : principal;
  capacity : opt nat64;
};
type Mail = record {
  id : nat64;
  from : principal;
  entry : blob;
  received_at_ns : nat64;
};
type MailItem = record {
  id : nat64;
  from : principal;
  entry : blob;
  received_at_ns : nat64;
  ephemeral : bool;
};
type PostError = variant {
  Invalid : text;
  NotMember;
  NotAllowed : text;
  NotFound;
  // A commit made in an older epoch: catch up to `current` and make it again.
  StaleEpoch : nat64;
};
type Result = variant { Ok : nat32; Err : text };
type Result_1 = variant { Ok; Err : text };
type Result_10 = variant { Ok : nat64; Err : PostError };
type Result_11 = variant { Ok : vec Entry; Err : PostError };
type Result_2 = variant { Ok : opt ClaimedKeyPackage; Err : text };
type Result_3 = variant { Ok : vec opt ClaimedKeyPackage; Err : text };
type Result_4 = variant { Ok : nat64; Err : text };
type Result_5 = variant { Ok : BatchResult; Err : text };
type Result_6 = variant { Ok : AccountExport; Err : text };
type Result_7 = variant { Ok : vec Mail; Err : text };
type Result_8 = variant { Ok : blob; Err : PostError };
type Result_9 = variant { Ok; Err : PostError };
type Role = variant { Member; Admin; Owner };
type Stats = record {
  stable_memory_bytes : nat64;
  shard_number : nat32;
  open : bool;
  cycles : nat;
  accounts : nat64;
  queued_entries : nat64;
  usage : Usage;
  capacity : nat64;
};
type Ticket = record {
  mac : blob;
  "principal" : principal;
  epoch : nat32;
  expires_at_ns : nat64;
};
// A ticket key. The identity canister signs with the newest; shards accept
// the newest two, so tickets stay valid across a key rotation.
type TicketKey = record { key : blob; epoch : nat32 };
type Usage = record {
  claims : nat64;
  acks : nat64;
  entries : nat64;
  deposits : nat64;
  since_ns : nat64;
};
service : (InitArgs) -> {
  ack_mail : (text, nat64) -> (Result);
  // Makes this shard the home of a new account.
  adopt_account : (principal) -> (Result_1);
  // Ends a failed move: the account takes entries here again.
  cancel_move : (principal) -> (Result_1);
  claim_key_package : (principal, text, opt Ticket) -> (Result_2);
  // Key packages of many devices in one call (adding people to a group chat).
  // At most 200 devices; each must live in this shard.
  claim_key_packages : (vec record { principal; text }, opt Ticket) -> (
      Result_3,
    );
  // Deletes the caller's devices, key packages and queued entries here (the
  // client also deletes its account in the identity canister).
  delete_account : () -> (Result_1);
  deposit : (principal, text, blob, opt Ticket) -> (Result_4);
  // Queues several entries in one call (all or nothing, in order). Every
  // recipient must live in this shard.
  deposit_batch : (vec DepositItem, opt Ticket) -> (Result_5);
  // Removes an account after it moved to another shard.
  drop_account : (principal) -> (Result_1);
  // An account's data, to move it to another shard. From now until
  // `drop_account` or `cancel_move`, new entries for it are refused ("Moved").
  export_account : (principal) -> (Result_6);
  fetch_mail : (text, nat64) -> (Result_7) query;
  // Public device keys of an account whose home is this shard (empty otherwise).
  get_devices : (principal) -> (vec Device) query;
  group_blob_get : (text, nat64, nat32) -> (Result_8) query;
  // One chunk of an encrypted file or Welcome, stored once for the whole group.
  group_blob_put : (text, nat64, nat32, nat32, nat64, blob) -> (Result_9);
  // Starts a group chat's stream here, with the caller as its owner.
  group_create : (text, opt Ticket) -> (Result_9);
  // Latest seq and epoch of each listed group the caller is in.
  group_heads : (vec text) -> (vec Head) query;
  group_leave : (text, opt principal) -> (Result_9);
  // An MLS application message for the group → its seq.
  group_post : (text, text, nat64, blob) -> (Result_10);
  // An MLS commit made in the current epoch, with the access-list change it brings → its seq.
  group_post_commit : (CommitArgs) -> (Result_10);
  // Entries after `after`, oldest first (members only).
  group_read : (text, nat64) -> (Result_11) query;
  group_set_role : (text, principal, Role) -> (Result_9);
  // Takes in an account moved from another shard (or from the identity canister).
  import_account : (principal, AccountExport) -> (Result_1);
  publish_key_packages : (text, opt blob, vec blob) -> (Result);
  register_device : (DeviceInput) -> (Result_1);
  remove_device : (text) -> (Result_1);
  // Opens or closes the shard to new accounts.
  set_open : (bool) -> (Result_1);
  set_ticket_keys : (vec TicketKey) -> (Result_1);
  stats : () -> (Stats) query;
}