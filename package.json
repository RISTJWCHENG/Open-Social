{
  "name": "open-social",
  "version": "1.0.0",
  "private": true,
  "description": "OpenSocial - privacy-first communication platform prototype (Phase 1).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/licenses/notices.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test && npm run build",
    "aleo:check": "node scripts/aleo/recovery-pass-check.mjs",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "5.1.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@icp-sdk/auth": "10.0.1",
    "@icp-sdk/core": "6.1.0",
    "@siafoundation/sia-storage": "0.1.3",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "16.37.0"
  },
  "devDependencies": {
    "@provablehq/sdk": "0.12.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "emojibase-data": "^16.0.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "@icp-sdk/signer": "6.0.0",
    "@provablehq/wasm": "0.12.0"
  },
  "license": "UNLICENSED"
}
